# ===== 数据库（Aiven MySQL）=====
# Aiven 控制台 → Service → Connection information 里复制
DATABASE_URL=mysql+pymysql://avnadmin:your-password@your-service.aivencloud.com:12345/defaultdb
# Aiven CA 证书下载后放到该路径（留空则只加密不验证证书）
DB_SSL_CA_PATH=backend/certs/ca.pem

# ===== 运行环境与跨域 =====
# 设为 production 时，启动会校验 JWT_SECRET 不能是默认值（本地开发保持 development 即可）
ENVIRONMENT=development
# 允许跨域的来源（逗号分隔）。前后端同域部署（Vercel 默认形态）时无需配置；
# 前后端分域部署时在此追加自己的前端域名，站点自身地址会自动加入。
# CORS_ORIGINS=https://your-frontend.example.com

# ===== 登录 =====
# 随机长字符串，可用 python -c "import secrets; print(secrets.token_hex(32))" 生成
JWT_SECRET=please-change-me
ADMIN_USERNAME=velpro
# 首次启动时若库里没有该用户会自动创建（仅首次生效，改密码请直接改库）
ADMIN_PASSWORD=

# ===== 智谱 GLM（AI 助手）=====
LONGCAT_API_KEY=
# 以下可选，默认值与旧配置一致
# LONGCAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LONGCAT_MODEL=glm-4-flash-250414
